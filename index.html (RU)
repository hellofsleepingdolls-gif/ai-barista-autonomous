    .glass-card {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-card:hover {
      border-color: rgba(6, 182, 212, 0.2);
      background: rgba(255, 255, 255, 0.045);
    }

    .neon-text {
      text-shadow: 0 0 40px rgba(6, 182, 212, 0.4), 0 0 80px rgba(6, 182, 212, 0.15);
    }

    .gradient-border {
      position: relative;
    }

    .gradient-border::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(135deg, rgba(6, 182, 212, 0.4), rgba(139, 111, 78, 0.3), rgba(6, 182, 212, 0.1));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    .screenshot-placeholder {
      background:
        linear-gradient(135deg, rgba(6, 182, 212, 0.03) 0%, transparent 50%),
        linear-gradient(225deg, rgba(139, 111, 78, 0.05) 0%, transparent 50%),
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 24px,
          rgba(255, 255, 255, 0.015) 24px,
          rgba(255, 255, 255, 0.015) 25px
        ),
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 24px,
          rgba(255, 255, 255, 0.015) 24px,
          rgba(255, 255, 255, 0.015) 25px
        );
    }

    .btn-neon {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-neon:hover {
      box-shadow: 0 0 30px rgba(6, 182, 212, 0.5), 0 0 80px rgba(6, 182, 212, 0.25), inset 0 0 20px rgba(6, 182, 212, 0.1);
      transform: translateY(-2px);
    }

    .btn-cta {
      font-size: 0.95rem;
      letter-spacing: 0.18em;
      padding: 1.35rem 2.75rem;
      border-width: 2px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @media (min-width: 640px) {
      .btn-cta {
        font-size: 1.05rem;
        padding: 1.6rem 3.5rem;
      }
    }

    .btn-cta:hover {
      animation: cta-neon-pulse 1.4s ease-in-out infinite;
      transform: translateY(-3px) scale(1.02);
      border-color: rgba(6, 182, 212, 0.85);
      background: linear-gradient(135deg, rgba(6, 182, 212, 0.35), rgba(6, 182, 212, 0.12));
    }

    @keyframes cta-neon-pulse {
      0%, 100% {
        box-shadow: 0 0 20px rgba(6, 182, 212, 0.4), 0 0 50px rgba(6, 182, 212, 0.15), inset 0 0 24px rgba(6, 182, 212, 0.08);
      }
      50% {
        box-shadow: 0 0 40px rgba(6, 182, 212, 0.75), 0 0 100px rgba(6, 182, 212, 0.35), 0 0 160px rgba(6, 182, 212, 0.12), inset 0 0 36px rgba(6, 182, 212, 0.15);
      }
    }

    .step-card {
      transition: border-color 0.35s ease, background 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
    }

    .step-card:hover {
      border-color: rgba(6, 182, 212, 0.25);
      background: rgba(255, 255, 255, 0.055);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35), 0 0 24px rgba(6, 182, 212, 0.08);
    }

    /* --- ROI calculator --- */
    .roi-widget {
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid rgba(6, 182, 212, 0.2);
      box-shadow: 0 0 40px rgba(6, 182, 212, 0.08), 0 20px 60px rgba(0, 0, 0, 0.4);
    }

    .roi-stat {
      background: rgba(6, 182, 212, 0.06);
      border: 1px solid rgba(6, 182, 212, 0.25);
      box-shadow: 0 0 30px rgba(6, 182, 212, 0.12), inset 0 0 20px rgba(6, 182, 212, 0.04);
      transition: box-shadow 0.4s ease, border-color 0.4s ease;
    }

    .roi-stat:hover {
      border-color: rgba(6, 182, 212, 0.45);
      box-shadow: 0 0 40px rgba(6, 182, 212, 0.25), inset 0 0 28px rgba(6, 182, 212, 0.08);
    }

    .roi-value {
      text-shadow: 0 0 30px rgba(6, 182, 212, 0.5), 0 0 60px rgba(6, 182, 212, 0.2);
      transition: transform 0.3s ease;
    }

    .roi-value.bump { transform: scale(1.04); }

    .roi-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 6px;
      border-radius: 999px;
      background: linear-gradient(to right, #06b6d4 var(--roi-pct, 8%), rgba(255,255,255,0.08) var(--roi-pct, 8%));
      outline: none;
      cursor: pointer;
    }

    .roi-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #06b6d4;
      border: 3px solid #0a0a0a;
      box-shadow: 0 0 16px rgba(6, 182, 212, 0.6);
      cursor: pointer;
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .roi-slider::-webkit-slider-thumb:hover {
      box-shadow: 0 0 24px rgba(6, 182, 212, 0.9);
      transform: scale(1.1);
    }

    .roi-slider::-moz-range-thumb {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #06b6d4;
      border: 3px solid #0a0a0a;
      box-shadow: 0 0 16px rgba(6, 182, 212, 0.6);
      cursor: pointer;
    }

    /* --- FAQ accordion --- */
    .faq-item { transition: border-color 0.3s ease, background 0.3s ease; }
    .faq-item.open { border-color: rgba(6, 182, 212, 0.25); background: rgba(255, 255, 255, 0.045); }

    .faq-trigger { cursor: pointer; }
    .faq-icon { transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1); }
    .faq-item.open .faq-icon { transform: rotate(180deg); }

    .faq-panel {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-item.open .faq-panel { grid-template-rows: 1fr; }

    .faq-panel-inner { overflow: hidden; }

    .nav-blur {
      background: rgba(10, 10, 10, 0.7);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    ::selection {
      background: rgba(6, 182, 212, 0.3);
      color: #fff;
    }

    .dot-grid {
      background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    /* --- Code editor panels --- */
    .code-panel {
      background: #0d0d0d;
      font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', ui-monospace, monospace;
      font-size: 11px;
      line-height: 1.65;
      overflow: auto;
    }

    @media (min-width: 640px) {
      .code-panel { font-size: 12px; }
    }

    .code-panel::-webkit-scrollbar { width: 6px; height: 6px; }
    .code-panel::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 3px; }

    .code-line {
      display: flex;
      padding: 0 12px 0 0;
      transition: background 0.15s ease;
    }

    .code-line:hover { background: rgba(6, 182, 212, 0.04); }

    .line-num {
      flex-shrink: 0;
      width: 2.5rem;
      text-align: right;
      padding-right: 12px;
      color: rgba(255, 255, 255, 0.18);
      user-select: none;
      border-right: 1px solid rgba(255, 255, 255, 0.05);
      margin-right: 12px;
    }

    .line-body { flex: 1; white-space: pre; overflow-x: auto; }

    .syn-kw   { color: #c792ea; }
    .syn-fn   { color: #82aaff; }
    .syn-str  { color: #c3e88d; }
    .syn-num  { color: #f78c6c; }
    .syn-cmt  { color: #546e7a; font-style: italic; }
    .syn-key  { color: #82aaff; }
    .syn-val  { color: #c3e88d; }
    .syn-brk  { color: #89ddff; }
    .syn-bool { color: #ffcb6b; }
    .syn-rcpt { color: #e2e8f0; }
    .syn-ico  { color: inherit; }
    .syn-hl   { color: #06b6d4; font-weight: 600; }
    .syn-tot  { color: #a68b6a; font-weight: 700; }

    /* --- n8n flow diagram --- */
    .flow-canvas {
      background:
        radial-gradient(circle at 20% 30%, rgba(6, 182, 212, 0.06) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(139, 111, 78, 0.06) 0%, transparent 50%),
        #080808;
      position: relative;
      overflow: hidden;
    }

    .flow-canvas::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
      background-size: 20px 20px;
      pointer-events: none;
    }

    .flow-grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0;
      padding: 24px 16px;
      min-height: 280px;
      position: relative;
      z-index: 1;
    }

    @media (min-width: 640px) {
      .flow-grid {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0 8px;
        padding: 32px 24px;
        min-height: 320px;
      }
    }

    .flow-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 14px 18px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      min-width: 120px;
      cursor: default;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }

    .flow-node:hover {
      transform: translateY(-4px) scale(1.03);
      border-color: var(--node-color, rgba(6, 182, 212, 0.5));
      background: rgba(255, 255, 255, 0.07);
      box-shadow: 0 0 24px var(--node-glow, rgba(6, 182, 212, 0.25)), 0 8px 32px rgba(0,0,0,0.4);
    }

    .flow-node.active {
      border-color: var(--node-color, rgba(6, 182, 212, 0.6));
      box-shadow: 0 0 20px var(--node-glow, rgba(6, 182, 212, 0.2));
    }

    .flow-node-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      background: var(--node-bg, rgba(6, 182, 212, 0.12));
    }

    .flow-node-label {
      font-size: 11px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.9);
      text-align: center;
      line-height: 1.3;
    }

    .flow-node-sub {
      font-size: 9px;
      color: rgba(255, 255, 255, 0.35);
      text-align: center;
      font-family: ui-monospace, monospace;
    }

    .flow-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(6, 182, 212, 0.4);
      padding: 6px 0;
      transition: color 0.3s ease;
    }

    .flow-arrow svg {
      width: 20px;
      height: 20px;
      animation: flow-pulse 2s ease-in-out infinite;
    }

    @media (min-width: 640px) {
      .flow-arrow {
        padding: 0 4px;
        transform: rotate(-90deg);
      }
      .flow-arrow svg { width: 24px; height: 24px; }
    }

    @keyframes flow-pulse {
      0%, 100% { opacity: 0.35; transform: translateY(0); }
      50% { opacity: 1; transform: translateY(3px); }
    }

    @media (min-width: 640px) {
      @keyframes flow-pulse {
        0%, 100% { opacity: 0.35; transform: translateX(0); }
        50% { opacity: 1; transform: translateX(3px); }
      }
    }

    .flow-node:hover + .flow-arrow,
    .flow-arrow:hover { color: rgba(6, 182, 212, 0.9); }

    .flow-badge {
      position: absolute;
      top: -8px;
      right: -8px;
      font-size: 8px;
      font-weight: 700;
      letter-spacing: 0.05em;
      padding: 2px 6px;
      border-radius: 6px;
      background: rgba(6, 182, 212, 0.2);
      color: #06b6d4;
      border: 1px solid rgba(6, 182, 212, 0.3);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .flow-node:hover .flow-badge { opacity: 1; }

    /* --- Accent effects --- */
    .badge-glow {
      animation: badge-shimmer 3s ease-in-out infinite;
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.15), inset 0 0 12px rgba(6, 182, 212, 0.05);
    }

    @keyframes badge-shimmer {
      0%, 100% { box-shadow: 0 0 16px rgba(6, 182, 212, 0.12), inset 0 0 10px rgba(6, 182, 212, 0.04); }
      50% { box-shadow: 0 0 28px rgba(6, 182, 212, 0.35), inset 0 0 16px rgba(6, 182, 212, 0.08); }
    }

    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse 50% 40% at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(6, 182, 212, 0.04) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
      transition: background 0.3s ease;
    }

    body > * { position: relative; z-index: 1; }
  </style>
</head>
