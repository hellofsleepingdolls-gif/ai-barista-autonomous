      background-image:
        radial-gradient(ellipse 80% 60% at 50% -10%, rgba(6, 182, 212, 0.12) 0%, transparent 55%),
        radial-gradient(ellipse 60% 50% at 90% 80%, rgba(139, 111, 78, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse 50% 40% at 10% 60%, rgba(6, 182, 212, 0.06) 0%, transparent 45%);
