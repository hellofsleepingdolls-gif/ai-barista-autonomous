  <script>
    document.querySelectorAll('.flow-node').forEach(function (node) {
      node.addEventListener('click', function () {
        document.querySelectorAll('.flow-node').forEach(function (n) { n.classList.remove('active'); });
        node.classList.add('active');
      });
    });

    var revealObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(function (el) { revealObserver.observe(el); });

    document.addEventListener('mousemove', function (e) {
      document.body.style.setProperty('--mouse-x', (e.clientX / window.innerWidth * 100) + '%');
      document.body.style.setProperty('--mouse-y', (e.clientY / window.innerHeight * 100) + '%');
    });

    /* ROI Calculator */
    var ordersSlider = document.getElementById('orders-slider');
    var ordersValue = document.getElementById('orders-value');
    var hoursSaved = document.getElementById('hours-saved');
    var profitSaved = document.getElementById('profit-saved');

    function formatProfit(n) {
      return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    }

    function bumpEl(el) {
      el.classList.add('bump');
      setTimeout(function () { el.classList.remove('bump'); }, 300);
    }

    function updateRoi() {
      var orders = parseInt(ordersSlider.value, 10);
      var hours = Math.round(orders * 5 * 30 / 60);
      var profit = orders * 150 * 30;

      ordersValue.textContent = orders;
      hoursSaved.textContent = hours;
      profitSaved.textContent = formatProfit(profit);

      var pct = ((orders - 10) / (500 - 10)) * 100;
      ordersSlider.style.setProperty('--roi-pct', pct + '%');

      bumpEl(hoursSaved);
      bumpEl(profitSaved);
    }

    if (ordersSlider) {
      ordersSlider.addEventListener('input', updateRoi);
      updateRoi();
    }

    /* FAQ Accordion */
    document.querySelectorAll('.faq-trigger').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.faq-item');
        var isOpen = item.classList.contains('open');

        document.querySelectorAll('.faq-item').forEach(function (el) {
          el.classList.remove('open');
          el.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
